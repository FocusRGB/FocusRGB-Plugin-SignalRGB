<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- TODO(FocusRGB/FocusRGB#79): keep the MAJ224 feed until FocusRgb.PluginSdk is published on nuget.org. -->
    <add key="github" value="https://nuget.pkg.github.com/MAJ224/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="xunit.*" />
      <package pattern="Microsoft.*" />
      <package pattern="System.*" />
    </packageSource>
    <packageSource key="github">
      <package pattern="FocusRgb.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
